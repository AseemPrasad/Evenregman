# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js / NextAuth
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=evenregman

# Redis (Optional - for atomic capacity reservation)
REDIS_URL=
ENABLE_ATOMIC_REGISTRATIONS=false

# Outbox Pattern (Optional - for async event processing)
ENABLE_OUTBOX_PATTERN=false
OUTBOX_RELAY_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_RETRIES=5
OUTBOX_MAX_RETRY_DELAY_MS=300000

# Rate Limiting (Optional - for abuse protection)
ENABLE_RATE_LIMITING=false
RATE_LIMIT_STRICT_MODE=false

# Async CSV Export (Optional - for background export processing)
# ENABLE_ASYNC_EXPORTS: Enable async export feature (returns 202 Accepted)
# ASYNC_EXPORTS_WORKER_ENABLED: Run background worker process
ENABLE_ASYNC_EXPORTS=false
ASYNC_EXPORTS_WORKER_ENABLED=false

# S3/R2 Storage (Required if async exports enabled)
# S3_BUCKET_NAME: S3 bucket name (e.g., "evenregman-exports")
# S3_REGION: AWS region or "auto" for Cloudflare R2
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY: AWS credentials for S3 access
S3_BUCKET_NAME=
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Enterprise RBAC/ABAC & Audit (Optional - for multi-tenant access control)
# ENABLE_RBAC_ENGINE: Enable role-based access control system
# RBAC_AUTO_BOOTSTRAP_ORGS: Auto-create personal orgs on first login
# RBAC_AUDIT_RETENTION_DAYS: How long to keep audit logs (default: 2555 = 7 years)
# RBAC_LOG_SENSITIVE_ACTIONS: Log VIEW_SENSITIVE actions separately
ENABLE_RBAC_ENGINE=false
RBAC_AUTO_BOOTSTRAP_ORGS=true
RBAC_AUDIT_RETENTION_DAYS=2555
RBAC_LOG_SENSITIVE_ACTIONS=false

# Two-Tier Edge & L2 Distributed Cache (Optional - for performance)
# ENABLE_L2_CACHE: Enable Redis L2 caching for public events
# CACHE_TTL_EVENTS: Cache TTL for single event (default: 3600s = 1 hour)
# CACHE_TTL_EVENTS_LIST: Cache TTL for event list (default: 300s = 5 min)
# CACHE_COMPRESSION_ENABLED: Enable gzip compression for large values
# CACHE_COMPRESSION_THRESHOLD_BYTES: Only compress if > this size (default: 1024)
ENABLE_L2_CACHE=false
CACHE_TTL_EVENTS=3600
CACHE_TTL_EVENTS_LIST=300
CACHE_COMPRESSION_ENABLED=true
CACHE_COMPRESSION_THRESHOLD_BYTES=1024